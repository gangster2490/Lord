<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Local CORS proxy (http://localhost:3001) and user-configured HTTP endpoints. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
